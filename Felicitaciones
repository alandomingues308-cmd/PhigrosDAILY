<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>¡Feliz Cumpleaños Interactivo! 🎉</title>
    <!-- Importamos una fuente bonita de Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;800&display=swap" rel="stylesheet">
    <!-- Librería para el confeti -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Poppins', sans-serif;
        }

        body {
            /* Degradado de tonos azules elegantes */
            background: linear-gradient(135deg, #0f2027 0%, #203a43 50%, #2c5364 100%);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: #f1f2f6;
            overflow-x: hidden;
            padding: 20px;
        }

        .container {
            background: rgba(15, 32, 39, 0.85);
            border: 2px solid rgba(0, 180, 216, 0.3);
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
            text-align: center;
            max-width: 600px;
            width: 100%;
            position: relative;
            animation: fadeIn 1.5s ease-in-out;
            backdrop-filter: blur(10px);
        }

        h1 {
            font-size: 2.5rem;
            color: #00b4d8;
            margin-bottom: 15px;
            font-weight: 800;
            text-shadow: 0 0 15px rgba(0, 180, 216, 0.4);
        }

        p {
            font-size: 1.1rem;
            color: #a0aec0;
            margin-bottom: 30px;
        }

        .cake {
            font-size: 5rem;
            margin-bottom: 20px;
            cursor: pointer;
            transition: transform 0.3s ease;
            display: inline-block;
            filter: drop-shadow(0 0 10px rgba(0, 180, 216, 0.5));
        }

        .cake:hover {
            transform: scale(1.2) rotate(5deg);
        }

        .btn {
            background-color: #0077b6;
            color: white;
            border: none;
            padding: 12px 25px;
            font-size: 1rem;
            font-weight: 600;
            border-radius: 50px;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(0, 119, 182, 0.4);
            transition: all 0.3s ease;
            margin: 5px;
        }

        .btn:hover {
            background-color: #00b4d8;
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(0, 180, 216, 0.6);
        }

        #mensaje-sorpresa {
            margin-top: 25px;
            font-size: 1.2rem;
            font-weight: 600;
            color: #48cae4;
            min-height: 50px;
            display: flex;
            align-items: center;
            justify-content: center;
            text-shadow: 0 0 10px rgba(72, 202, 228, 0.3);
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-20px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body>

    <div class="container">
        <!-- Pastel interactivo -->
        <div class="cake" onclick="lanzarConfeti()" title="¡Haz clic en el pastel!">🎂</div>
        
        <h1 id="titulo-cumple">¡Feliz Cumpleaños!</h1>
        <p>Feliz cumpleaños atrasado, presiona los botones</p>

        <!-- Botones de interacción -->
        <div>
            <button class="btn" onclick="lanzarConfeti()">🎉 ¡Lanzar Confeti!</button>
            <button class="btn" onclick="mostrarMensaje()">✨ Mensaje Especial</button>
        </div>

        <!-- Área de mensajes dinámicos -->
        <div id="mensaje-sorpresa"></div>
    </div>

    <script>
        // Array de frases de felicitación
        const frases = [
            "🌟 Dejate embarrar en el pastel",
            "🎁 Feliz cumpleaños (Alan)",
            "🎈 Felicitaciones punchis (Anónimo)",
            "🎁 Feliz cumpleaños puto! (Diego)",
            "🥂 No te emborraches",


        ];

        function lanzarConfeti() {
            // Efecto de confeti con tonos azules y celestes combinados
            confetti({
                particleCount: 120,
                spread: 70,
                origin: { y: 0.6 },
                colors: ['#00b4d8', '#0077b6', '#90e0ef', '#48cae4', '#ffffff']
            });
        }

        function mostrarMensaje() {
            const contenedorMensaje = document.getElementById("mensaje-sorpresa");
            const fraseAleatoria = frases[Math.floor(Math.random() * frases.length)];
            
            contenedorMensaje.style.opacity = 0;
            setTimeout(() => {
                contenedorMensaje.textContent = fraseAleatoria;
                contenedorMensaje.style.opacity = 1;
                contenedorMensaje.style.transition = "opacity 0.5s ease-in-out";
            }, 200);

            // Confeti lateral con tonos azules
            confetti({
                particleCount: 50,
                angle: 60,
                spread: 55,
                origin: { x: 0 },
                colors: ['#00b4d8', '#90e0ef', '#caf0f8']
            });
            confetti({
                particleCount: 50,
                angle: 120,
                spread: 55,
                origin: { x: 1 },
                colors: ['#0077b6', '#00b4d8', '#ffffff']
            });
        }
    </script>

</body>
</html>
