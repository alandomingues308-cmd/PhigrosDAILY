<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>¡Feliz Cumpleaños Interactivo! 🎉</title>
    <!-- Importamos una fuente bonita de Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;800&display=swap" rel="stylesheet">
    <!-- Librería para el confeti -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 99%, #feada6 100%);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: #333;
            overflow-x: hidden;
            padding: 20px;
        }

        .container {
            background: rgba(255, 255, 255, 0.9);
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
            text-align: center;
            max-width: 600px;
            width: 100%;
            position: relative;
            animation: fadeIn 1.5s ease-in-out;
        }

        h1 {
            font-size: 2.5rem;
            color: #ff4757;
            margin-bottom: 15px;
            font-weight: 800;
        }

        p {
            font-size: 1.1rem;
            color: #555;
            margin-bottom: 30px;
        }

        .cake {
            font-size: 5rem;
            margin-bottom: 20px;
            cursor: pointer;
            transition: transform 0.3s ease;
            display: inline-block;
        }

        .cake:hover {
            transform: scale(1.2) rotate(5deg);
        }

        .btn {
            background-color: #ff4757;
            color: white;
            border: none;
            padding: 12px 25px;
            font-size: 1rem;
            font-weight: 600;
            border-radius: 50px;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(255, 71, 87, 0.4);
            transition: all 0.3s ease;
            margin: 5px;
        }

        .btn:hover {
            background-color: #ff6b81;
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(255, 71, 87, 0.6);
        }

        #mensaje-sorpresa {
            margin-top: 25px;
            font-size: 1.2rem;
            font-weight: 600;
            color: #2ed573;
            min-height: 50px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-20px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body>

    <div class="container">
        <!-- Pastel interactivo -->
        <div class="cake" onclick="lanzarConfeti()" title="¡Haz clic en el pastel!">🎂</div>
        
        <h1 id="titulo-cumple">¡Feliz Cumpleaños!</h1>
        <p>Que este día esté lleno de alegría, sorpresas y momentos inolvidables. ¡Haz clic en los botones para celebrar!</p>

        <!-- Botones de interacción -->
        <div>
            <button class="btn" onclick="lanzarConfeti()">🎉 ¡Lanzar Confeti!</button>
            <button class="btn" onclick="mostrarMensaje()">✨ Mensaje Especial</button>
        </div>

        <!-- Área de mensajes dinámicos -->
        <div id="mensaje-sorpresa"></div>
    </div>

    <script>
        // Array de frases de felicitación para mostrar de forma aleatoria
        const frases = [
            "🌟 ¡Te deseo un año lleno de metas cumplidas y mucha felicidad!",
            "🚀 Que la vida te sorprenda hoy y siempre con grandes momentos.",
            "🎈 ¡A por un año más de grandes aventuras y sonrisas!",
            "🎁 Que todos tus deseos se hagan realidad en este nuevo año de vida.",
            "🥂 ¡Brindemos por ti y por todo lo maravilloso que está por venir!"
        ];

        function lanzarConfeti() {
            // Efecto de confeti utilizando la librería externa
            confetti({
                particleCount: 120,
                spread: 70,
                origin: { y: 0.6 }
            });
        }

        function mostrarMensaje() {
            const contenedorMensaje = document.getElementById("mensaje-sorpresa");
            // Selecciona una frase aleatoria del arreglo
            const fraseAleatoria = frases[Math.floor(Math.random() * frases.length)];
            
            contenedorMensaje.style.opacity = 0;
            setTimeout(() => {
                contenedorMensaje.textContent = fraseAleatoria;
                contenedorMensaje.style.opacity = 1;
                contenedorMensaje.style.transition = "opacity 0.5s ease-in-out";
            }, 200);

            // Lanza un pequeño confeti extra al mostrar el mensaje
            confetti({
                particleCount: 50,
                angle: 60,
                spread: 55,
                origin: { x: 0 }
            });
            confetti({
                particleCount: 50,
                angle: 120,
                spread: 55,
                origin: { x: 1 }
            });
        }
    </script>

</body>
</html>
